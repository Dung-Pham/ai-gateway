# CHỈ DÙNG CHO DEV trên máy cá nhân (xem control/README.md). Triển khai thật KHÔNG dùng tệp này:
# Docker Compose nạp biến và bí mật cho giao diện (xem deploy/.env.example và docs/BAN_GIAO_TRIEN_KHAI.md).
# Sao thành control/.env rồi chạy `php artisan key:generate`. KHÔNG commit control/.env.

APP_NAME="Cổng AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dữ liệu mẫu giả để xem giao diện (dev). KHÔNG bật ở production.
GATEWAY_DEMO=true
# Tài khoản đăng nhập thử cho `php artisan db:seed`: tự đặt giá trị thử, không dùng mật khẩu thật.
GATEWAY_DEMO_ADMIN_EMAIL=
GATEWAY_DEMO_ADMIN_PASSWORD=

# --- Cổng AI (dev)
# Nối với gateway thật (chỉ khi chạy dev cùng gateway; ở chế độ demo, đồng bộ bị bỏ qua).
GATEWAY_URL=http://127.0.0.1:8771
GATEWAY_ADMIN_TOKEN=
# Thư mục cài đặt trên máy AI, chỉ để hiện đúng lệnh đăng nhập trong hướng dẫn.
AIGW_INSTALL_DIR=/opt/aigw/ai-gateway
# Dải mạng được vào giao diện (CIDR, cách nhau bằng dấu phẩy). Để trống = khóa hết.
ADMIN_ALLOWED_CIDRS=127.0.0.0/8
REQUIRE_2FA=false
TRUSTED_PROXIES=
