# Sao chép thành deploy/.env rồi điền. KHÔNG commit tệp .env (đã nằm trong .gitignore).
# Giá trị bí mật KHÔNG để ở đây: chúng nằm trong thư mục SECRETS_DIR do `scripts/gwctl.py init` tạo.

# --- Bí mật và phiên bản
SECRETS_DIR=./secrets          # đường dẫn tuyệt đối khuyến nghị, ví dụ /opt/aigw/secrets (quyền 700, chủ sở hữu người vận hành)
AIGW_VERSION=0.2.0             # nhãn ảnh Docker; đổi khi nâng cấp

# --- Giao diện điều khiển (web)
APP_URL=https://aigw.congty.example     # địa chỉ người dùng gõ vào trình duyệt (dùng cho liên kết và cookie)
APP_TIMEZONE=Asia/Ho_Chi_Minh
WEB_BIND=127.0.0.1             # IP máy lắng nghe giao diện. Đặt IP nội bộ của máy nếu truy cập từ máy khác
WEB_PORT=8080                  # cổng công bố ra máy chủ (8443 bên trong nếu WEB_MODE=tls)
WEB_MODE=http                  # http (đứng sau reverse proxy của công ty có TLS) hoặc tls (Caddy tự phục vụ TLS bằng chứng chỉ trong WEB_CERT_DIR)
WEB_INNER_PORT=8080            # 8080 khi WEB_MODE=http, 8443 khi WEB_MODE=tls
WEB_CERT_DIR=./certs           # chứa fullchain.pem và privkey.pem khi WEB_MODE=tls
ADMIN_ALLOWED_CIDRS=10.0.0.0/8 # dải mạng được VÀO giao diện quản trị (CIDR, cách nhau bằng dấu phẩy). Để trống = khóa hết
REQUIRE_2FA=true               # bắt buộc xác thực hai bước
TRUSTED_PROXIES=               # chỉ điền IP reverse proxy của công ty nếu có (để lấy đúng IP người dùng), ví dụ 10.0.0.5

# --- Gateway (API cho các ứng dụng)
GATEWAY_BIND=127.0.0.1         # IP nội bộ của máy AI để máy chủ SEO Studio gọi tới, ví dụ 10.0.5.20. KHÔNG dùng 0.0.0.0 nếu không có tường lửa
GATEWAY_PORT=8771
GATEWAY_CHECK_MODELS=          # tùy chọn: model rẻ dùng cho "Kiểm tra ngay", ví dụ claude=haiku,grok=grok-4.7,agy=gemini-4-neon-high

# --- Người dùng chạy giao diện/gateway: PHẢI đọc được các tệp trong SECRETS_DIR (bí mật quyền 0600).
#     Cách dễ nhất: đặt bằng uid/gid của người vận hành đã chạy `gwctl.py init` (lệnh `id -u`, `id -g`). Hoặc dùng 10001 và `sudo chown -R 10001:10001 $SECRETS_DIR`.
AIGW_UID=10001
AIGW_GID=10001

# --- UID/GID sở hữu thư mục auth của runner (phải khớp: sudo chown -R 10001:10001 <SECRETS_DIR>/<nhãn>/auth)
RUNNER_UID=10001
RUNNER_GID=10001

# --- CLI của hãng AI trên máy chủ (gắn chỉ-đọc vào runner) và băm SHA-256 đã ghim (xem runner/pins/versions.env)
CLI_CLAUDE=/opt/cli/claude
CLI_GROK=/opt/cli/grok
CLI_AGY=/opt/cli/agy
CLAUDE_SHA256=
GROK_SHA256=
AGY_SHA256=
