#!/bin/sh
# Lệnh vận hành duy nhất cho Cổng AI. Tự ghép docker-compose.yml với mọi runner trong deploy/runners.d/*.yml.
#   aigw preflight      kiểm tra máy đã sẵn sàng chưa (chạy TRƯỚC khi khởi động lần đầu)
#   aigw up             dựng ảnh (nếu cần) và khởi động toàn bộ
#   aigw down           dừng (KHÔNG xóa dữ liệu)
#   aigw ps | logs [dịch_vụ] | restart [dịch_vụ]
#   aigw health         kiểm tra từng thành phần và in kết quả đạt/không đạt
#   aigw login <hãng> <nhãn>    đăng nhập tài khoản AI trong container sạch (người sở hữu tài khoản làm, qua SSH có terminal)
#   aigw create-admin <email>   tạo quản trị viên đầu tiên (hỏi mật khẩu tại chỗ)
#   aigw artisan <lệnh>         chạy lệnh artisan trong giao diện (đã nạp bí mật)
#   aigw <lệnh docker compose khác>
set -eu
HERE="$(cd "$(dirname "$0")" && pwd)"
DEPLOY="$HERE/../deploy"
cd "$DEPLOY"
[ -f .env ] || { echo "Thiếu deploy/.env. Sao deploy/.env.example thành deploy/.env và điền (xem docs/BAN_GIAO_TRIEN_KHAI.md)." >&2; exit 1; }
FILES="-f docker-compose.yml"
if [ -d runners.d ]; then
    for f in runners.d/*.yml; do [ -e "$f" ] && FILES="$FILES -f $f"; done
fi
# shellcheck disable=SC2086
PROJ=""; [ -n "${AIGW_PROJECT:-}" ] && PROJ="-p $AIGW_PROJECT"   # chỉ dùng khi diễn tập song song với bản thật
dc() { docker compose $PROJ --env-file .env $FILES "$@"; }
getenv() { sed -n "s/^$1=\\(.*\\)$/\\1/p" .env | tail -1; }

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
    preflight) exec "$HERE/preflight.sh" ;;
    up) dc up -d --build "$@" ;;
    down) dc down "$@" ;;
    ps) dc ps "$@" ;;
    logs) dc logs --tail=200 -f "$@" ;;
    restart) dc restart "$@" ;;
    create-admin) dc run --rm control php artisan gateway:create-admin "$@" ;;
    login)
        # Đăng nhập tài khoản AI TRONG CONTAINER SẠCH (không keychain, không D-Bus): token chỉ ghi vào thư mục auth của runner.
        prov="${1:-}"; label="${2:-}"
        [ -n "$prov" ] && [ -n "$label" ] || { echo "Dùng: aigw login <claude|grok|agy|codex> <nhãn>" >&2; exit 2; }
        sd="$(getenv SECRETS_DIR)"; sd="${sd:-./secrets}"; case "$sd" in /*) ;; *) sd="$PWD/$sd" ;; esac
        [ -d "$sd/$label/auth" ] || { echo "Chưa có $sd/$label/auth: chạy trước gwctl.py new-runner $sd $prov $label" >&2; exit 1; }
        ru="$(getenv RUNNER_UID)"; rg="$(getenv RUNNER_GID)"; ru="${ru:-10001}"; rg="${rg:-10001}"
        case "$prov" in
            claude) bin="$(getenv CLI_CLAUDE)"; name=claude; rel=".credentials.json"; run='CLAUDE_CONFIG_DIR=/tmp/h /opt/cli/claude auth login' ;;
            grok)   bin="$(getenv CLI_GROK)";   name=grok;   rel="auth.json";         run='GROK_HOME=/tmp/h /opt/cli/grok login --device-code' ;;
            agy)    bin="$(getenv CLI_AGY)";    name=agy;    rel=".gemini/antigravity-cli/antigravity-oauth-token"; run='/opt/cli/agy' ;;
            codex)  bin="$(getenv CLI_CODEX)";  name=codex;  rel="auth.json";         run='CODEX_HOME=/tmp/h /opt/cli/codex login --device-auth' ;;
            *) echo "Hãng phải là claude|grok|agy|codex" >&2; exit 2 ;;
        esac
        [ -x "$bin" ] || { echo "Không thấy CLI $bin (CLI_* trong .env)" >&2; exit 1; }
        echo "Sẽ đăng nhập $prov cho nhãn '$label'. Làm theo hướng dẫn của CLI (mở đường dẫn trên trình duyệt của BẠN, dán mã vào đây)."
        [ "$prov" = agy ] && echo "agy: chọn 'Google OAuth', đăng nhập xong thoát CLI bằng Ctrl+C hoặc /quit để lưu token."
        tty="-i"; [ -t 0 ] && tty="-it"
        docker run --rm $tty --user "$ru:$rg" --cap-drop ALL --security-opt no-new-privileges --pids-limit 256 --memory 1g \
            --tmpfs /tmp:rw,size=256m,mode=1777 -e HOME=/tmp/h \
            -v "$bin:/opt/cli/$name:ro" -v "$sd/$label/auth:/auth" python:3.12-slim-bookworm \
            sh -c "mkdir -p /tmp/h; $run; if [ -s /tmp/h/$rel ]; then mkdir -p \"/auth/\$(dirname $rel)\" && cp -p /tmp/h/$rel /auth/$rel && chmod 600 /auth/$rel && echo 'ĐÃ LƯU token vào thư mục auth.'; else echo 'KHÔNG thấy tệp token: đăng nhập chưa hoàn tất.' >&2; exit 1; fi"
        echo "Tiếp theo: giao diện > Tài khoản AI > $label > Kiểm tra ngay." ;;
    artisan) dc exec -T control aigw-entrypoint php artisan "$@" ;;
    health)
        ok=0; bad=0
        chk() { if [ "$2" = "ok" ]; then echo "  [ĐẠT]     $1"; ok=$((ok+1)); else echo "  [KHÔNG]   $1 — $2"; bad=$((bad+1)); fi; }
        for s in db control scheduler web egress-proxy gateway; do
            st=$(dc ps --format '{{.Service}} {{.State}} {{.Health}}' "$s" 2>/dev/null | head -1)
            case "$st" in *running*healthy*|*"running "|*running) chk "dịch vụ $s" ok ;; *) chk "dịch vụ $s" "${st:-không chạy}" ;; esac
        done
        for r in $(dc config --services | grep '^runner-' || true); do
            st=$(dc ps --format '{{.State}}' "$r" 2>/dev/null | head -1); [ "$st" = "running" ] && chk "$r" ok || chk "$r" "${st:-không chạy}"
        done
        gp="$(getenv GATEWAY_PORT)"; gp="${gp:-8771}"; gh="$(getenv GATEWAY_BIND)"; gh="${gh:-127.0.0.1}"; [ "$gh" = "0.0.0.0" ] && gh=127.0.0.1
        gs=http; [ "$(getenv WEB_MODE)" = "tls" ] && gs=https
        curl -fsSk -m 5 "$gs://$gh:$gp/healthz" >/dev/null 2>&1 && chk "API /healthz qua cửa Caddy ($gh:$gp)" ok || chk "API /healthz qua cửa Caddy ($gh:$gp)" "không trả lời"
        code=$(curl -sk -m 5 -o /dev/null -w "%{http_code}" "$gs://$gh:$gp/internal/state" 2>/dev/null); [ "$code" = "404" ] && chk "/internal/* KHÔNG lộ ra ngoài" ok || chk "/internal/* KHÔNG lộ ra ngoài" "trả mã $code (phải 404)"
        wp="$(getenv WEB_PORT)"; wp="${wp:-8080}"
        scheme=http; [ "$(getenv WEB_MODE)" = "tls" ] && scheme=https
        curl -fsSk -m 5 "$scheme://127.0.0.1:$wp/up" >/dev/null 2>&1 && chk "giao diện /up (cổng $wp)" ok || chk "giao diện /up (cổng $wp)" "không trả lời"
        dc exec -T control aigw-entrypoint php artisan gateway:sync >/dev/null 2>&1 && chk "giao diện đọc được trạng thái gateway (gateway:sync)" ok || chk "giao diện đọc được trạng thái gateway (gateway:sync)" "lỗi"
        echo; echo "Đạt $ok, không đạt $bad."; [ "$bad" -eq 0 ] ;;
    help|-h|--help) sed -n '2,14p' "$0" ;;
    *) dc "$cmd" "$@" ;;
esac
